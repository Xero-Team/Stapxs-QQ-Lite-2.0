# Description: 项目环境变量配置文件
# PS：配置文件中的所有 URL 请不要添加末尾的斜杠，代码功能中会添加它

# 客户端标签
# 客户端标签用于区分其他认可的社区版本客户端
# 目前会影响统计数据和统一公告的展示
VITE_APP_CLIENT_TAG=classic

# Legacy analytics variables intentionally empty; no telemetry is implemented.
VITE_APP_MU_ADDRESS=
VITE_APP_MU_ID=
VITE_APP_MU_DATA_API=

# 高德地图相关设置
VITE_APP_AMAP_KEY=
VITE_APP_AMAP_SECRET=
VITE_APP_EMOJI_CDN=

# SSE 模式相关设置
# SSE 模式仅限 Web 端使用，请在构建其他端时关闭此功能
# 开发环境请留意 vite.config.ts 中 server.proxy 配置
VITE_APP_SSE_MODE=false
VITE_APP_SSE_SUPPORT=true
VITE_APP_SSE_EVENT_ADDRESS=api/_events
VITE_APP_SSE_HTTP_ADDRESS=api

# 功能 API 相关设置
VITE_APP_LINK_VIEW=

# 杂项 API 相关设置
## 网易云音乐 API（https://www.npmjs.com/package/NeteaseCloudMusicApi）
VITE_APP_163_MUSIC_API=

# 其他
## GitHub 仓库名称
VITE_APP_REPO_NAME=XeroTeam/Stapxs-QQ-Lite-2.0
# Optional deployment base path (for example /my-repository/ on GitHub Pages).
VITE_APP_BASE_PATH=
VITE_APP_RELEASES_URL=
VITE_APP_PINYIN_URL=

# 是否下载表情到本地
VITE_LOCAL_FACE=false
