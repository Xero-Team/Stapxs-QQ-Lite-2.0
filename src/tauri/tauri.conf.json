{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Xero QQ Lite",
    "version": "../../package.json",
    "identifier": "team.xero.qqlite",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:8080",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../../dist"
    },
    "app": {
        "macOSPrivateApi": true,
        "security": {
            "csp": "default-src 'self' asset:; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: http: https:; media-src 'self' asset: data: blob: http: https:; font-src 'self' asset: data:; connect-src 'self' ipc: http: https: ws: wss:; frame-src 'self' http: https:; worker-src 'self' blob:;",
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
        "schemes": ["xero-qq-lite"]
            }
        }
    },
    "bundle": {
        "active": true,
        "copyright": "Copyright © 2026 Xero-Team",
        "homepage": "https://github.com/XeroTeam/Stapxs-QQ-Lite-2.0",
        "longDescription": "一个兼容 OneBot 协议的非官方 QQ 全平台客户端实现。",
        "shortDescription": "一个兼容 OneBot 协议的非官方 QQ 全平台客户端实现。",
        "publisher": "Xero-Team",
        "license": "AGPL-3.0-only",
        "targets": "all",
        "useLocalToolsDir": true,
        "icon": [
            "../../build/icon-client-mac.icns",
            "../../build/icon-client-others.png",
            "../../build/icon-client-others.ico"
        ],
        "macOS": {
            "signingIdentity": "-",
            "dmg": {
                "appPosition": {
                    "x": 112,
                    "y": 110
                },
                "applicationFolderPosition": {
                    "x": 396,
                    "y": 110
                },
                "windowSize": {
                    "height": 302,
                    "width": 517
                },
                "background": "../../build/dmg-bg.png"
            },
            "entitlements": "../../build/entitlements.mac.plist"
        },
        "windows": {
            "allowDowngrades": false,
            "webviewInstallMode": {
                "silent": true,
                "type": "downloadBootstrapper"
            },
            "wix": null
        },
        "linux": {
            "deb": {
                "desktopTemplate": "../../build/debian.desktop"
            }
        }
    }
}
