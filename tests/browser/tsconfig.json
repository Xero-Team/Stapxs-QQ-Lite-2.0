{
  "extends": "../../tsconfig.web.json",
  "include": ["./*.ts", "./*.vue"],
  "exclude": ["./vite.config.ts"],
  "compilerOptions": {
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  }
}
